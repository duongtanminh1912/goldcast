{
  "uid": "goldcast-operations",
  "title": "GoldCast — Operations",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "goldcast",
    "devops"
  ],
  "panels": [
    {
      "id": 1,
      "title": "HTTPS sẵn sàng",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "goldcast-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"public\"}",
          "legendFormat": "{{instrument}}{{provider}}{{service}}{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "TLS còn lại (ngày)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "goldcast-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(probe_ssl_earliest_cert_expiry{job=\"public\"}-time())/86400",
          "legendFormat": "{{instrument}}{{provider}}{{service}}{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Cảnh báo đang firing",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "goldcast-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "{{instrument}}{{provider}}{{service}}{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Phiên bản ứng dụng",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "goldcast-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "goldcast_release_info",
          "legendFormat": "{{instrument}}{{provider}}{{service}}{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.release_id}"
        },
        "overrides": []
      },
      "options": {
        "textMode": "name"
      }
    },
    {
      "id": 5,
      "title": "CPU VPS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "goldcast-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1-avg(rate(node_cpu_seconds_total{job=\"vps-node\",mode=\"idle\"}[5m]))",
          "legendFormat": "{{instrument}}{{provider}}{{service}}{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "RAM khả dụng",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "goldcast-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{job=\"vps-node\"}",
          "legendFormat": "{{instrument}}{{provider}}{{service}}{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Đĩa còn trống",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "goldcast-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{job=\"vps-node\",mountpoint=\"/\"}",
          "legendFormat": "{{instrument}}{{provider}}{{service}}{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Container ready",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "goldcast-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "goldcast_container_ready",
          "legendFormat": "{{instrument}}{{provider}}{{service}}{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "API request/giây",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "goldcast-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"goldcast-backend\",uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{instrument}}{{provider}}{{service}}{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "API 5xx/giây",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "goldcast-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"goldcast-backend\",status=~\"5..\",uri!~\"/actuator.*\"}[5m])) or vector(0)",
          "legendFormat": "{{instrument}}{{provider}}{{service}}{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "API latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "goldcast-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(http_server_requests_seconds_bucket{job=\"goldcast-backend\",uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "{{instrument}}{{provider}}{{service}}{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "JVM heap",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "goldcast-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"goldcast-backend\",area=\"heap\"})",
          "legendFormat": "{{instrument}}{{provider}}{{service}}{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
