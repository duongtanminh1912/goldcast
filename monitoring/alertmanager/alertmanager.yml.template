global:
  resolve_timeout: 5m
route:
  receiver: telegram
  group_by: [site, alertname]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 6h
  routes:
    # Heartbeat to the external dead-man check, re-sent every minute while firing.
    # It must stay first so the Watchdog never falls through to Telegram.
    - receiver: deadman
      matchers: ['alertname="GoldcastWatchdog"']
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m
    - receiver: dashboard-only
      matchers: ['severity="info"']
    - receiver: telegram
      matchers: ['alertname="GoldcastMonitoringTest"']
      group_wait: 0s
      group_interval: 10s
receivers:
  - name: deadman
    webhook_configs:
      - url_file: /run/secrets/deadman_ping_url
        send_resolved: false
        max_alerts: 1
  - name: dashboard-only
  - name: telegram
    telegram_configs:
      - bot_token_file: /run/secrets/telegram_bot_token
        chat_id: __CHAT_ID__
        send_resolved: true
        parse_mode: HTML
        message: |
          <b>GoldCast {{ .Status | toUpper }}</b>
          {{ range .Alerts }}
          <b>{{ .Labels.alertname | html }}</b> [{{ .Labels.severity | html }}]
          {{ .Annotations.summary | html }}
          {{ .Annotations.description | html }}
          Runbook: {{ .Annotations.runbook | html }}
          {{ end }}
inhibit_rules:
  - source_matchers: ['alertname="GoldcastLiveGoldPollingStalled"']
    target_matchers: ['alertname=~"GoldcastLiveGoldFetchFailed|GoldcastLiveGoldQuoteStale"']
    equal: [site]
  - source_matchers: ['alertname="GoldcastLiveGoldFetchFailed"']
    target_matchers: ['alertname="GoldcastLiveGoldQuoteStale"']
    equal: [site]
  - source_matchers: ['alertname="GoldcastMonitoringTunnelUnavailable"']
    target_matchers: ['alertname=~"GoldcastBackendMetricsUnavailable|GoldcastBackendNotReady|GoldcastRuntimeCollectorStale|GoldcastRuntimeCollectorFailed"']
    equal: [site]
  - source_matchers: ['alertname="GoldcastRuntimeCollectorStale"']
    target_matchers: ['alertname=~"GoldcastContainerNotReady|GoldcastPublicVersionMismatch|GoldcastImageMismatch|GoldcastReleaseLockStuck"']
    equal: [site]
  # Backend down: readiness (critical) speaks for the whole JVM, and the data-freshness
  # rules only go quiet because their metrics vanished, not because data is stale.
  - source_matchers: ['alertname="GoldcastBackendNotReady"']
    target_matchers: ['alertname="GoldcastBackendMetricsUnavailable"']
    equal: [site]
  - source_matchers: ['alertname=~"GoldcastBackendMetricsUnavailable|GoldcastBackendNotReady"']
    target_matchers: ['alertname=~"GoldcastMarketMetricsStale|GoldcastMacroDataStale"']
    equal: [site]
  # Burn-rate alerts restate an incident a symptom alert already reports. While that
  # symptom fires, only it notifies; once it resolves, a burn alert still firing means
  # budget was really spent (or errors are intermittent) and then it does notify.
  - source_matchers: ['alertname="GoldcastWebsiteUnavailable"']
    target_matchers: ['alertname=~"GoldcastSLOAvailabilityFastBurn|GoldcastSLOAvailabilitySlowBurn"']
    equal: [site]
  - source_matchers: ['alertname=~"GoldcastBackendNotReady|GoldcastAPIErrors"']
    target_matchers: ['alertname=~"GoldcastSLOAPIFastBurn|GoldcastSLOAPISlowBurn"']
    equal: [site]
