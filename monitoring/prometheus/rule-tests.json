{
  "rule_files": [
    "alerts.yml"
  ],
  "evaluation_interval": "1m",
  "tests": [
    {
      "name": "brief outage does not page",
      "interval": "1m",
      "input_series": [
        {
          "series": "probe_success{job=\"public\"}",
          "values": "1 0 1 1 1"
        }
      ],
      "promql_expr_test": [
        {
          "expr": "count(ALERTS{alertname=\"GoldcastWebsiteUnavailable\",alertstate=\"firing\"}) or vector(0)",
          "eval_time": "3m",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 0
            }
          ]
        }
      ]
    },
    {
      "name": "sustained outage fires then resolves",
      "interval": "1m",
      "input_series": [
        {
          "series": "probe_success{job=\"public\"}",
          "values": "0 0 0 0 1 1 1"
        }
      ],
      "promql_expr_test": [
        {
          "expr": "count(ALERTS{alertname=\"GoldcastWebsiteUnavailable\",alertstate=\"firing\"}) or vector(0)",
          "eval_time": "3m",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 1
            }
          ]
        },
        {
          "expr": "count(ALERTS{alertname=\"GoldcastWebsiteUnavailable\",alertstate=\"firing\"}) or vector(0)",
          "eval_time": "6m",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 0
            }
          ]
        }
      ]
    },
    {
      "name": "backup age counts from verified success",
      "interval": "1m",
      "input_series": [
        {
          "series": "goldcast_jenkins_job_last_success_timestamp_seconds{job_name=\"goldcast-backup\"}",
          "values": "0+0x1920"
        }
      ],
      "promql_expr_test": [
        {
          "expr": "count(ALERTS{alertname=\"GoldcastBackupStale\",alertstate=\"firing\"}) or vector(0)",
          "eval_time": "29h",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 0
            }
          ]
        },
        {
          "expr": "count(ALERTS{alertname=\"GoldcastBackupStale\",alertstate=\"firing\"}) or vector(0)",
          "eval_time": "31h",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 1
            }
          ]
        }
      ]
    },
    {
      "name": "deploy lock suppresses transition mismatch",
      "interval": "1m",
      "input_series": [
        {
          "series": "goldcast_public_release_matches_manifest{job=\"vps-node\",instance=\"vps\"}",
          "values": "0+0x8"
        },
        {
          "series": "goldcast_public_identity_probe_success{job=\"vps-node\",instance=\"vps\"}",
          "values": "1+0x8"
        },
        {
          "series": "goldcast_release_lock_exists{job=\"vps-node\",instance=\"vps\"}",
          "values": "1 1 1 0 0 0 0 0 0"
        },
        {
          "series": "goldcast_release_state_read_success{job=\"vps-node\",instance=\"vps\"}",
          "values": "1 1 1 0 0 1 1 1 1"
        }
      ],
      "promql_expr_test": [
        {
          "expr": "count(ALERTS{alertname=\"GoldcastPublicVersionMismatch\",alertstate=\"firing\"}) or vector(0)",
          "eval_time": "2m",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 0
            }
          ]
        },
        {
          "expr": "count(ALERTS{alertname=\"GoldcastPublicVersionMismatch\",alertstate=\"firing\"}) or vector(0)",
          "eval_time": "4m",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 0
            }
          ]
        },
        {
          "expr": "count(ALERTS{alertname=\"GoldcastPublicVersionMismatch\",alertstate=\"firing\"}) or vector(0)",
          "eval_time": "8m",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 1
            }
          ]
        }
      ]
    },
    {
      "name": "disabled provider does not page",
      "interval": "1h",
      "input_series": [
        {
          "series": "goldcast_ingest_provider_last_success_timestamp{provider=\"stooq\",job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "0+0x5"
        },
        {
          "series": "goldcast_ingest_provider_enabled{provider=\"stooq\",job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "0+0x5"
        },
        {
          "series": "goldcast_ingest_enabled{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "1+0x5"
        },
        {
          "series": "process_start_time_seconds{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "0+0x5"
        }
      ],
      "promql_expr_test": [
        {
          "expr": "count(ALERTS{alertname=\"GoldcastProviderUnavailable\",alertstate=\"firing\"}) or vector(0)",
          "eval_time": "4h",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 0
            }
          ]
        }
      ]
    },
    {
      "name": "stuck poll does not remain green when HTTP exporter is up",
      "interval": "1m",
      "input_series": [
        {
          "series": "goldcast_jenkins_collector_last_run_timestamp_seconds{job=\"jenkins-operations\",instance=\"exporter\"}",
          "values": "0+0x6"
        },
        {
          "series": "goldcast_jenkins_scrape_success{job=\"jenkins-operations\",instance=\"exporter\",job_name=\"goldcast-ci\"}",
          "values": "1+0x6"
        },
        {
          "series": "up{job=\"jenkins-operations\",instance=\"exporter\"}",
          "values": "1+0x6"
        }
      ],
      "promql_expr_test": [
        {
          "expr": "count(ALERTS{alertname=\"GoldcastJenkinsUnavailable\",alertstate=\"firing\"}) or vector(0)",
          "eval_time": "1m",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 0
            }
          ]
        },
        {
          "expr": "count(ALERTS{alertname=\"GoldcastJenkinsUnavailable\",alertstate=\"firing\"}) or vector(0)",
          "eval_time": "6m",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 1
            }
          ]
        }
      ]
    },
    {
      "name": "receipt keeps advancing but source quote is stale",
      "interval": "1m",
      "input_series": [
        {
          "series": "goldcast_live_gold_enabled{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "1+0x12"
        },
        {
          "series": "up{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "1+0x12"
        },
        {
          "series": "goldcast_live_gold_last_fetch_timestamp{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "0+60x12"
        },
        {
          "series": "goldcast_live_gold_observed_timestamp{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "0+0x12"
        },
        {
          "series": "goldcast_live_gold_stale_after_seconds{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "180+0x12"
        },
        {
          "series": "goldcast_live_gold_expected_updates{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "1+0x12"
        }
      ],
      "promql_expr_test": [
        {
          "expr": "count(ALERTS{alertname=\"GoldcastLiveGoldQuoteStale\",alertstate=\"firing\"}) or vector(0)",
          "eval_time": "8m",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 1
            }
          ]
        }
      ]
    },
    {
      "name": "reference session pause suppresses stale source alert",
      "interval": "1m",
      "input_series": [
        {
          "series": "goldcast_live_gold_enabled{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "1+0x12"
        },
        {
          "series": "up{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "1+0x12"
        },
        {
          "series": "goldcast_live_gold_observed_timestamp{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "0+0x12"
        },
        {
          "series": "goldcast_live_gold_stale_after_seconds{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "180+0x12"
        },
        {
          "series": "goldcast_live_gold_expected_updates{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "0+0x12"
        }
      ],
      "promql_expr_test": [
        {
          "expr": "count(ALERTS{alertname=\"GoldcastLiveGoldQuoteStale\",alertstate=\"firing\"}) or vector(0)",
          "eval_time": "8m",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 0
            }
          ]
        }
      ]
    },
    {
      "name": "fetch outage is still reported during session pause",
      "interval": "1m",
      "input_series": [
        {
          "series": "goldcast_live_gold_enabled{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "1+0x12"
        },
        {
          "series": "up{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "1+0x12"
        },
        {
          "series": "goldcast_live_gold_fetch_success{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "0+0x12"
        },
        {
          "series": "goldcast_live_gold_expected_updates{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "0+0x12"
        }
      ],
      "promql_expr_test": [
        {
          "expr": "count(ALERTS{alertname=\"GoldcastLiveGoldFetchFailed\",alertstate=\"firing\"}) or vector(0)",
          "eval_time": "4m",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 1
            }
          ]
        }
      ]
    },
    {
      "name": "scheduler stalled while backend scrape stays healthy",
      "interval": "1m",
      "input_series": [
        {
          "series": "goldcast_live_gold_enabled{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "1+0x12"
        },
        {
          "series": "up{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "1+0x12"
        },
        {
          "series": "goldcast_live_gold_last_attempt_timestamp{job=\"goldcast-backend\",instance=\"backend\"}",
          "values": "0+0x12"
        }
      ],
      "promql_expr_test": [
        {
          "expr": "count(ALERTS{alertname=\"GoldcastLiveGoldPollingStalled\",alertstate=\"firing\"}) or vector(0)",
          "eval_time": "6m",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 1
            }
          ]
        }
      ]
    }
  ]
}
