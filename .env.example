# Copy to .env before `docker compose up`
POSTGRES_DB=goldcast
POSTGRES_USER=goldcast
POSTGRES_PASSWORD=goldcast
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=3000

# Browser-facing backend URL (must be reachable from the user's browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Ingest
APP_INGEST_ENABLED=true
# If the instrument has no history at all, generate a deterministic synthetic series
# so the app is usable offline / on first boot. Set to false in production.
APP_INGEST_SEED_ON_EMPTY=true

# Giá vàng thế giới và tỷ giá lấy từ Twelve Data (API chính thức, gói miễn phí).
# Lấy key tại https://twelvedata.com/register. Để trống thì dùng dữ liệu mô phỏng.
TWELVEDATA_API_KEY=
