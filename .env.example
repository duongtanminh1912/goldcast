# Copy to .env before `docker compose up`
POSTGRES_DB=goldcast
POSTGRES_USER=goldcast
POSTGRES_PASSWORD=goldcast
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=3000

# Frontend goi API o phia server. Compose dat API_BASE_URL_INTERNAL=http://backend:8080.
# Khi chay frontend ngoai Docker, dat API_BASE_URL_INTERNAL trong frontend/.env.local.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Ingest
APP_INGEST_ENABLED=true
APP_INGEST_CRON=0 7 * * * *
# If the instrument has no history at all, generate a deterministic synthetic series
# so the app is usable offline / on first boot. This example is for local dev.
# Production defaults to false; set explicitly in its own .env.
APP_INGEST_SEED_ON_EMPTY=true

# Token bao ve /api/v1/admin/**. Sinh bang: openssl rand -hex 32
# De trong thi endpoint admin bi khoa hoan toan (khoa mac dinh).
APP_ADMIN_TOKEN=
